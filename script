local function createTabButton(text, x)
	local button = makeButton(
		tabs,
		text,
		Color3.fromRGB(28, 32, 45),
		UDim2.new(0, x, 0, 0),
		UDim2.new(0, 92, 0, 32)
	)

	button.Activated:Connect(function()
		playTabSound()
		switchTab(text)

		for _, child in ipairs(tabs:GetChildren()) do
			if child:IsA("TextButton") then
				child.BackgroundColor3 = Color3.fromRGB(28, 32, 45)
			end
		end

		button.BackgroundColor3 = Color3.fromRGB(75, 130, 255)
	end)

	return button
end

