local function executeMacro()
	if not state.macroEnabled then
		state.macroEnabled = true
		state.toggles.Macro = true

		if not state.flying then
			startFly()
		end

		if not state.espEnabled then
			state.espEnabled = true
			refreshESPAll()
		end

		if not state.lockEnabled then
			state.lockEnabled = true
			local target = getBestTarget()
			if target then
				lockOn(target)
			end
		end

		macroButton.Text = "Macro: ON"
		macroButton.BackgroundColor3 = Color3.fromRGB(195, 125, 55)
		setStatus("macro enabled (fly + esp + lock)")
	else
		state.macroEnabled = false
		state.toggles.Macro = false

		stopFly()
		state.espEnabled = false
		clearESPAll()
		unlock()

		macroButton.Text = "Macro: OFF"
		macroButton.BackgroundColor3 = Color3.fromRGB(215, 145, 65)
		setStatus("macro disabled")
	end

	playFunctionSound()
	saveSettings()
end

