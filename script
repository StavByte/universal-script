RunService.RenderStepped:Connect(function()
	if freeCamActive and freeCamMouseLook and lastMousePos then
		local currentMousePos = UserInputService:GetMouseLocation()
		local delta = currentMousePos - lastMousePos

		local yaw = -delta.X * 0.15
		local pitch = -delta.Y * 0.15

		local currentCFrame = freeCamGyro
		local position = currentCFrame.Position
		local lookVector = currentCFrame.LookVector
		local rightVector = currentCFrame.RightVector
		local upVector = currentCFrame.UpVector

		local horizontal = CFrame.Angles(0, math.rad(yaw), 0)
		local vertical = CFrame.Angles(math.rad(pitch), 0, 0)

		local newLook = (horizontal * vertical):VectorToWorldSpace(lookVector)
		freeCamGyro = CFrame.new(position, position + newLook)
		camera.CFrame = freeCamGyro

		lastMousePos = currentMousePos
	end

	if state.lockTarget then
		if not state.lockTarget.Character then
			unlock()
			return
		end

		local targetPart = getTargetPart(state.lockTarget)
		local targetHumanoid = state.lockTarget.Character:FindFirstChildOfClass("Humanoid")

		if not targetPart or not targetHumanoid or targetHumanoid.Health <= 0 then
			unlock()
			return
		end

		if not root then
			return
		end

		local targetPosition = targetPart.Position
		local desiredPosition =
			root.Position
			- root.CFrame.LookVector * 10
			+ Vector3.new(0, 2.5, 0)

		local desiredCamera = CFrame.new(
			desiredPosition,
			targetPosition
		)

		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = camera.CFrame:Lerp(desiredCamera, 0.14)

		root.CFrame = CFrame.new(
			root.Position,
			Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z)
		)

		if lockBillboard and lockBillboard.Adornee ~= targetPart then
			lockBillboard.Adornee = targetPart
		end
	end
end)

