local function playUISound(soundId, playbackSpeed, volume, duration)
	local sound = Instance.new("Sound")
	sound.Name = "V30_TemporaryUISound"
	sound.SoundId = soundId
	sound.PlaybackSpeed = playbackSpeed or 1
	sound.Volume = volume or 0.35
	sound.Parent = SoundService

	SoundService:PlayLocalSound(sound)

	task.delay(math.min(duration or 2, 2), function()
		if sound and sound.Parent then
			sound:Stop()
			sound:Destroy()
		end
	end)
end

local function playFunctionSound()
	playUISound("rbxassetid://12221967", 1, 0.38, 2)
end

local function playTabSound()
	playUISound("rbxassetid://12221967", 0.78, 0.25, 2)
end

local function playHoverSound()
	local now = os.clock()

	if now - lastHoverTime < 0.12 then
		return
	end

	lastHoverTime = now
	playUISound("rbxassetid://9118828564", 1, 0.12, 0.35)
end

local function roundify(object, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = object
end

local function addStroke(object, color, thickness, transparency)
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Color = color
	uiStroke.Thickness = thickness or 1
	uiStroke.Transparency = transparency or 0
	uiStroke.Parent = object
	return uiStroke
end

