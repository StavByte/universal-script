		end

		if espObjects[plr].billboard then
			espObjects[plr].billboard:Destroy()
		end

		espObjects[plr] = nil
	end
end

local function updateESPText(plr, data)
	if not data or not data.label or not data.label.Parent then
		return
	end

	if not data.humanoid or not data.humanoid.Parent then
		return
	end

	local parts = {}

	if state.espOptions.name then
		table.insert(parts, plr.Name)
	end

	if state.espOptions.hp then
		table.insert(
			parts,
			"HP: "
				.. math.floor(data.humanoid.Health)
				.. "/"
				.. math.floor(data.humanoid.MaxHealth)
		)
	end

	data.label.Text = table.concat(parts, " | ")
end

local function getTeamColor(plr)
	if not state.espOptions.colorByTeam then
		return Color3.fromRGB(255, 75, 75)
	end

	local team = plr.Team

	if not team then
		return Color3.fromRGB(255, 75, 75)
	end

	if team.Name == "Red" or string.find(string.lower(team.Name), "red") then
		return Color3.fromRGB(255, 60, 60)
	elseif team.Name == "Blue" or string.find(string.lower(team.Name), "blue") then
		return Color3.fromRGB(60, 120, 255)
	elseif team.Name == "Green" or string.find(string.lower(team.Name), "green") then
		return Color3.fromRGB(60, 255, 120)
	else
		return Color3.fromRGB(255, 200, 60)
	end
end

local function createESP(plr)
	if plr == player then
		return
	end

	if not state.espEnabled then
		return
	end

	if not plr.Character then
		return
	end

	local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
	local targetHumanoid = plr.Character:FindFirstChildOfClass("Humanoid")

	if not hrp or not targetHumanoid then
		return
	end

	local localHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

	if not localHRP then
		return
	end

	local distance = (hrp.Position - localHRP.Position).Magnitude

	if distance > state.espOptions.maxDistance then
		removeESP(plr)
		return
	end

	if state.espOptions.teamOnly then
		local localTeam = player.Team
		local targetTeam = plr.Team

		if not localTeam or not targetTeam or localTeam ~= targetTeam then
			removeESP(plr)
			return
		end
	end

	if targetHumanoid.Health > state.espOptions.hpThreshold then
		removeESP(plr)
		return
	end

	removeESP(plr)

	local char = plr.Character

	local highlight

	if state.espOptions.highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "V30_ESP_Highlight"
		highlight.Adornee = char
		highlight.FillColor = getTeamColor(plr)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0
		highlight.Parent = char
	end

	local billboard
	local label

	if state.espOptions.name or state.espOptions.hp then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "V30_ESP_Billboard"
		billboard.Adornee = hrp
		billboard.AlwaysOnTop = true
		billboard.Size = UDim2.new(0, 180, 0, 30)
		billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		billboard.Parent = char

		label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeTransparency = 0.3
		label.Font = Enum.Font.GothamSemibold
		label.TextScaled = true
		label.Parent = billboard
	end

	local data = {
		highlight = highlight,
		billboard = billboard,
		label = label,
		humanoid = targetHumanoid,
	}

	espObjects[plr] = data

	espConnections[plr] = targetHumanoid.HealthChanged:Connect(function()
		updateESPText(plr, data)
	end)

	updateESPText(plr, data)
end

local function refreshESPAll()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			createESP(plr)
		end
	end
end

local function clearESPAll()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			removeESP(plr)
		end
	end
end

local function hookESPPlayer(plr)
	if plr == player then
		return
	end

	plr.CharacterAdded:Connect(function()
		task.wait(0.25)

		if state.espEnabled then
			createESP(plr)
		end
	end)

	plr.CharacterRemoving:Connect(function()
		removeESP(plr)
	end)

	if plr.Character and state.espEnabled then
		createESP(plr)
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
	hookESPPlayer(plr)
end

Players.PlayerAdded:Connect(function(plr)
	hookESPPlayer(plr)
	refreshPlayers()
end)

Players.PlayerRemoving:Connect(function(plr)
	removeESP(plr)
	refreshPlayers()
end)

local function isPointerOverGui()
	local mousePosition = UserInputService:GetMouseLocation()
	local objects = playerGui:GetGuiObjectsAtPosition(
		mousePosition.X,
		mousePosition.Y
	)

	for _, object in ipairs(objects) do
		if object:IsDescendantOf(gui) then
			return true
		end
	end

	return false
end

local function teleportToMouse()
	if not state.tpMode then
		return
	end

	if isPointerOverGui() then
		return
	end

	if not character or not root then
		return
	end

	local mousePosition = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(
		mousePosition.X,
		mousePosition.Y
	)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	local result = workspace:Raycast(
		ray.Origin,
		ray.Direction * 1000,
		params
	)

	if result then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))

		task.wait()

		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero

		setStatus("teleported")
		playFunctionSound()
	end
end

