local function loadSettings()
	local saved = playerGui:GetAttribute("DebugMenuV24_Settings")

	if saved and typeof(saved) == "string" then
		local success, data = pcall(function()
			return game:GetService("HttpService"):JSONDecode(saved)
		end)

		if success and data then
			if data.flySpeed then state.flySpeed = data.flySpeed end
			if data.walkSpeed then state.walkSpeed = data.walkSpeed end
			if data.flyNoclip then state.flyNoclip = data.flyNoclip end
			if data.espOptions then
				for k, v in pairs(data.espOptions) do
					state.espOptions[k] = v
				end
			end
			if data.keybinds then
				for k, v in pairs(data.keybinds) do
					if typeof(v) == "string" then
						local key = Enum.KeyCode[v]
						if key then
							state.keybinds[k] = key
						end
					end
				end
			end
			if data.theme then state.theme = data.theme end
			if data.freeCamSpeed then freeCamSpeed = data.freeCamSpeed end
		end
	end
end

local function saveSettings()
	local data = {
		flySpeed = state.flySpeed,
		walkSpeed = state.walkSpeed,
		flyNoclip = state.flyNoclip,
		espOptions = state.espOptions,
		keybinds = {},
		theme = state.theme,
		freeCamSpeed = freeCamSpeed,
	}

	for k, v in pairs(state.keybinds) do
		if v then
			data.keybinds[k] = v.Name
		end
	end

	local json = game:GetService("HttpService"):JSONEncode(data)
	playerGui:SetAttribute("DebugMenuV24_Settings", json)
end

