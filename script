local function removeESP(plr)
	if espConnections[plr] then
		espConnections[plr]:Disconnect()
		espConnections[plr] = nil
	end

	if espObjects[plr] then
		if espObjects[plr].highlight then
			espObjects[plr].highlight:Destroy()
		end

		if espObjects[plr].billboard then
			espObjects[plr].billboard:Destroy()
		end

		espObjects[plr] = nil
	end
end

local function updateESPText(plr, data)
	if not data or not data.label or not data.label.Parent then
		return
	end

	if not data.humanoid or not data.humanoid.Parent then
		return
	end

	local parts = {}

	if state.espOptions.name then
		table.insert(parts, plr.Name)
	end

	if state.espOptions.hp then
		table.insert(
			parts,
			"HP: "
				.. math.floor(data.humanoid.Health)
				.. "/"
				.. math.floor(data.humanoid.MaxHealth)
		)
	end

	data.label.Text = table.concat(parts, " | ")
end

local function createESP(plr)
	if plr == player then
		return
	end

	if not state.espEnabled then
		return
	end

	if not plr.Character then
		return
	end

	if state.espOptions.teamOnly then
		local localTeam = player.Team
		local targetTeam = plr.Team

		if not localTeam or not targetTeam or localTeam ~= targetTeam then
			removeESP(plr)
			return
		end
	end

	local distance = (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
		and (plr.Character and plr.Character:FindFirstChild("HumanoidRootPart"))
		and (player.Character:FindFirstChild("HumanoidRootPart").Position
			- plr.Character:FindFirstChild("HumanoidRootPart").Position).Magnitude
		or 0

	if distance > state.espOptions.distance then
		removeESP(plr)
		return
	end

	removeESP(plr)

	local char = plr.Character
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local targetHumanoid = char:FindFirstChildOfClass("Humanoid")

	if not hrp or not targetHumanoid then
		return
	end

	local highlight

	if state.espOptions.highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "V24_ESP_Highlight"
		highlight.Adornee = char
		highlight.FillColor = Color3.fromRGB(255, 75, 75)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.7
		highlight.OutlineTransparency = 0
		highlight.Parent = char
	end

	local billboard
	local label

	if state.espOptions.name or state.espOptions.hp then
		billboard = Instance.new("BillboardGui")
		billboard.Name = "V24_ESP_Billboard"
		billboard.Adornee = hrp
		billboard.AlwaysOnTop = true
		billboard.Size = UDim2.new(0, 190, 0, 32)
		billboard.StudsOffset = Vector3.new(0, 3.2, 0)
		billboard.Parent = char

		label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeTransparency = 0.3
		label.Font = Enum.Font.GothamSemibold
		label.TextScaled = true
		label.Parent = billboard
	end

	local data = {
		highlight = highlight,
		billboard = billboard,
		label = label,
		humanoid = targetHumanoid,
	}

	espObjects[plr] = data

	espConnections[plr] = targetHumanoid.HealthChanged:Connect(function()
		updateESPText(plr, data)
	end)

	updateESPText(plr, data)
end

local function refreshESPAll()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			createESP(plr)
		end
	end
end

local function clearESPAll()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			removeESP(plr)
		end
	end
end

local function hookESPPlayer(plr)
	if plr == player then
		return
	end

	plr.CharacterAdded:Connect(function()
		task.wait(0.25)

		if state.espEnabled then
			createESP(plr)
		end
	end)

	plr.CharacterRemoving:Connect(function()
		removeESP(plr)
	end)

	if plr.Character and state.espEnabled then
		createESP(plr)
	end
end

for _, plr in ipairs(Players:GetPlayers()) do
