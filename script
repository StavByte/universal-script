local function addLogEntry(text)
	table.insert(eventLog, 1, os.clock() .. " | " .. text)

	if #eventLog > 20 then
		table.remove(eventLog)
	end

	if logLabel then
		local lines = {}
		for i = 1, math.min(8, #eventLog) do
			table.insert(lines, eventLog[i])
		end
		logLabel.Text = table.concat(lines, "\n")
	end
end

