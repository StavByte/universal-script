local function makeDraggable(handle, target)
	local dragging = false
	local dragStart
	local startPosition

	handle.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end

		dragging = true
		dragStart = input.Position
		startPosition = target.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end)

	handle.InputChanged:Connect(function(input)
		if not dragging then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart

			target.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)
end

local function makeLabel(parent, text, position, size)
	local label = Instance.new("TextLabel")
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = Color3.fromRGB(175, 180, 195)
	label.Font = Enum.Font.Gotham
	label.TextSize = 12
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.ZIndex = 5
	label.Parent = parent
	return label
end

local function makeButton(parent, text, color, position, size)
	local button = Instance.new("TextButton")
	button.Size = size
	button.Position = position
	button.BackgroundColor3 = color
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.GothamSemibold
	button.TextSize = 14
	button.Active = true
	button.Selectable = true
	button.ZIndex = 6
	button.Parent = parent

	roundify(button, 11)
	addStroke(button, Color3.fromRGB(255, 255, 255), 1, 0.88)

	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = button

	button.MouseEnter:Connect(function()
		playHoverSound()
		scale.Scale = 1.025
	end)

	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)

	return button
end

local function applyTheme(themeName)
	state.theme = themeName

	if themeName == "Light" then
		main.BackgroundColor3 = Color3.fromRGB(245, 247, 255)
		topbar.BackgroundColor3 = Color3.fromRGB(235, 238, 248)
		accent.BackgroundColor3 = Color3.fromRGB(65, 120, 235)

		title.TextColor3 = Color3.fromRGB(35, 40, 55)
		statusLabel.TextColor3 = Color3.fromRGB(40, 45, 60)
		debugLabel.TextColor3 = Color3.fromRGB(40, 180, 90)

		for _, frame in pairs(tabFrames) do
			for _, child in ipairs(frame:GetDescendants()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = Color3.fromRGB(35, 40, 55)
				elseif child:IsA("TextBox") then
					child.TextColor3 = Color3.fromRGB(35, 40, 55)
				end
			end
		end
	elseif themeName == "Dark" then
		main.BackgroundColor3 = Color3.fromRGB(14, 16, 23)
		topbar.BackgroundColor3 = Color3.fromRGB(23, 26, 37)
		accent.BackgroundColor3 = Color3.fromRGB(75, 130, 255)

		title.TextColor3 = Color3.fromRGB(245, 247, 255)
		statusLabel.TextColor3 = Color3.fromRGB(170, 175, 190)
		debugLabel.TextColor3 = Color3.fromRGB(120, 220, 145)

		for _, frame in pairs(tabFrames) do
			for _, child in ipairs(frame:GetDescendants()) do
				if child:IsA("TextLabel") then
					child.TextColor3 = Color3.fromRGB(170, 175, 190)
				elseif child:IsA("TextBox") then
					child.TextColor3 = Color3.fromRGB(170, 175, 190)
				end
			end
		end
	end

	saveSettings()
end

