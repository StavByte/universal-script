local fpsCounter = 0
local frameAccumulator = 0
local lastFpsUpdate = 0
local pingValue = 0

local function updateInfo()
	if not humanoid or not root then
		return
	end

	local dt = RunService.RenderStepped:Wait()
	frameAccumulator = frameAccumulator + dt
	fpsCounter = fpsCounter + 1

	if frameAccumulator >= 0.5 then
		local currentFps = math.floor(fpsCounter / frameAccumulator)
		fpsCounter = 0
		frameAccumulator = 0

		fpsLabel.Text = "FPS: " .. currentFps

		if fpsOverlay then
			fpsOverlay.TextLabel.Text = "FPS: " .. currentFps
		end
	end

	local stats = StatsService and StatsService:GetStatistics()
	pingValue = stats and stats.Ping or player:GetNetworkPing() * 1000
	pingLabel.Text = "Ping: " .. math.floor(pingValue) .. "ms"

	posXLabel.Text = "Position X: " .. string.format("%.2f", root.Position.X)
	posYLabel.Text = "Position Y: " .. string.format("%.2f", root.Position.Y)
	posZLabel.Text = "Position Z: " .. string.format("%.2f", root.Position.Z)
	coordsLabel.Text = "Position: " .. string.format("%.2f, %.2f, %.2f", root.Position.X, root.Position.Y, root.Position.Z)
	healthLabel.Text = "Health: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
	walkSpeedInfoLabel.Text = "WalkSpeed: " .. humanoid.WalkSpeed
	jumpPowerInfoLabel.Text = "JumpPower: " .. humanoid.JumpPower

	if hpFill then
		local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		hpFill.Size = UDim2.new(hpPercent, 0, 1, 0)
		hpFill.BackgroundColor3 = hpPercent > 0.5 and Color3.fromRGB(75, 180, 120) or Color3.fromRGB(220, 60, 60)
	end

	if speedFill then
		local speedPercent = math.clamp(humanoid.WalkSpeed / 50, 0, 1)
		speedFill.Size = UDim2.new(speedPercent, 0, 1, 0)
	end

	if pingOverlay then
		pingOverlay.TextLabel.Text = "Ping: " .. math.floor(pingValue) .. "ms"
	end

	if hpOverlay then
		local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
		hpOverlay.Frame.Fill.Size = UDim2.new(hpPercent, 0, 1, 0)
		hpOverlay.TextLabel.Text = "HP: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth)
	end
end

