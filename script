local function getBestTarget()
	local position = camera.CFrame.Position
	local direction = camera.CFrame.LookVector

	local bestPlayer
	local bestScore = 0.88

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local targetPart = getTargetPart(plr)
			local targetHumanoid = plr.Character:FindFirstChildOfClass("Humanoid")

			if targetPart and targetHumanoid and targetHumanoid.Health > 0 then
				local offset = targetPart.Position - position

				if offset.Magnitude <= 120 then
					local score = direction:Dot(offset.Unit)

					if score > bestScore then
						bestScore = score
						bestPlayer = plr
					end
				end
			end
		end
	end

	return bestPlayer
end

local originalCollisions = {}

local function enableFlyNoclip()
	if not character then
		return
	end

	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			originalCollisions[part] = part.CanCollide
			part.CanCollide = false
		end
	end

	setStatus("fly noclip enabled")
end

local function disableFlyNoclip()
	for part, original in pairs(originalCollisions) do
		if part and part.Parent then
			part.CanCollide = original
		end
	end

	originalCollisions = {}
	setStatus("fly noclip disabled")
end

local function stopFly()
	disableFlyNoclip()

	state.flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end

	if flyGyro then
		flyGyro:Destroy()
		flyGyro = nil
	end

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	if flyButton then
		flyButton.Text = "Fly: OFF"
	end
end

local function startFly()
	if state.flying then
		return
	end

	if not character or not humanoid or humanoid.Health <= 0 then
		setStatus("fly unavailable")
		return
	end

	root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		setStatus("root missing")
		return
	end

	stopFly()
	state.flying = true

	if state.flyNoclip then
		enableFlyNoclip()
	end

	flyVelocity = Instance.new("BodyVelocity")
	flyVelocity.Name = "V24_FlyVelocity"
	flyVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	flyVelocity.Velocity = Vector3.zero
	flyVelocity.Parent = root

	flyGyro = Instance.new("BodyGyro")
	flyGyro.Name = "V24_FlyGyro"
	flyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	flyGyro.P = 1e4
	flyGyro.CFrame = root.CFrame
	flyGyro.Parent = root

	flyConnection = RunService.RenderStepped:Connect(function()
		if not state.flying then
			return
		end

		if not character or not character.Parent then
			stopFly()
			return
		end

		root = character:FindFirstChild("HumanoidRootPart")
		humanoid = character:FindFirstChildOfClass("Humanoid")

		if not root or not humanoid or humanoid.Health <= 0 then
			stopFly()
			setStatus("fly stopped")
			return
		end

		local movement = Vector3.zero
		local cam = workspace.CurrentCamera

		if flyKeys.W then
			movement += cam.CFrame.LookVector
		end

		if flyKeys.S then
			movement -= cam.CFrame.LookVector
		end

		if flyKeys.D then
			movement += cam.CFrame.RightVector
		end

		if flyKeys.A then
			movement -= cam.CFrame.RightVector
		end

		if flyKeys.Space then
			movement += Vector3.new(0, 1, 0)
		end

		if flyKeys.Ctrl then
			movement -= Vector3.new(0, 1, 0)
		end

		if movement.Magnitude > 0 then
			movement = movement.Unit * state.flySpeed
		end

		flyVelocity.Velocity = movement
		flyGyro.CFrame = cam.CFrame
	end)
end

local function startFreeCam()
	if freeCamActive then
		return
	end

	freeCamActive = true
	freeCamVelocity = Vector3.zero
	freeCamGyro = camera.CFrame

	setStatus("free cam on")
	playFunctionSound()

	freeCamConnection = RunService.RenderStepped:Connect(function()
		if not freeCamActive then
			return
		end

		local movement = Vector3.zero
		local cam = workspace.CurrentCamera

		if flyKeys.W then
			movement += cam.CFrame.LookVector
		end

		if flyKeys.S then
			movement -= cam.CFrame.LookVector
		end

		if flyKeys.D then
			movement += cam.CFrame.RightVector
		end

		if flyKeys.A then
			movement -= cam.CFrame.RightVector
		end

		if flyKeys.Space then
			movement += Vector3.new(0, 1, 0)
		end

		if flyKeys.Ctrl then
			movement -= Vector3.new(0, 1, 0)
		end

		if movement.Magnitude > 0 then
			movement = movement.Unit * freeCamSpeed
		end

		freeCamGyro = CFrame.new(
			freeCamGyro.Position + freeCamGyro.LookVector * movement.Magnitude * 0.016,
			freeCamGyro.Position + freeCamGyro.LookVector
		)

		camera.CFrame = freeCamGyro
	end)
end

local function stopFreeCam()
	if not freeCamActive then
		return
	end

	freeCamActive = false

	if freeCamConnection then
		freeCamConnection:Disconnect()
		freeCamConnection = nil
	end

	camera.CameraType = Enum.CameraType.Custom
	camera.CameraSubject = humanoid

	setStatus("free cam off")
	playFunctionSound()
end

