local function playUISound(soundId, playbackSpeed, volume, duration)
	local sound = Instance.new("Sound")
	sound.Name = "V24_TemporaryUISound"
	sound.SoundId = soundId
	sound.PlaybackSpeed = playbackSpeed or 1
	sound.Volume = volume or 0.35
	sound.Parent = SoundService

	SoundService:PlayLocalSound(sound)

	task.delay(math.min(duration or 2, 2), function()
		if sound and sound.Parent then
			sound:Stop()
			sound:Destroy()
		end
	end)
end

local function playFunctionSound()
	playUISound("rbxassetid://12221967", 1, 0.38, 2)
end

local function playTabSound()
