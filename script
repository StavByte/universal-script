UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if waitingBind and input.UserInputType == Enum.UserInputType.Keyboard then
		state.keybinds[waitingBind] = input.KeyCode
		updateBindButton(waitingBind)
		setStatus(waitingBind .. " bound to " .. input.KeyCode.Name)
		waitingBind = nil
		playFunctionSound()
		saveSettings()
		return
	end

	for command, keyCode in pairs(state.keybinds) do
		if keyCode and input.KeyCode == keyCode then
			if command == "Heal" then
				healPlayer()
			elseif command == "Reset" then
				resetPlayer()
			elseif command == "Ragdoll" then
				ragdollSelf(not state.ragdolled)
				ragdollButton.Text = "Ragdoll: " .. (state.ragdolled and "ON" or "OFF")
			elseif command == "Fly" then
				if state.toggles.Fly then
					stopFly()
					flyButton.Text = "Fly: OFF"
				else
					startFly()
					flyButton.Text = "Fly: ON"
				end
			elseif command == "ESP" then
				state.espEnabled = not state.espEnabled
				espButton.Text = "ESP: " .. (state.espEnabled and "ON" or "OFF")

				if state.espEnabled then
					refreshESPAll()
				else
					clearESPAll()
				end
			elseif command == "Speed" then
				if humanoid then
					humanoid.WalkSpeed = state.walkSpeed
				end
			elseif command == "Lock" then
				state.lockEnabled = not state.lockEnabled
				lockButton.Text = "Lock On: " .. (state.lockEnabled and "ON" or "OFF")

				if state.lockEnabled then
					local target = getBestTarget()
					if target then
						lockOn(target)
					end
				else
					unlock()
				end
			elseif command == "TPClick" then
				state.tpMode = not state.tpMode
				tpButton.Text = "Click TP: " .. (state.tpMode and "ON" or "OFF")
			elseif command == "Macro" then
				executeMacro()
			elseif command == "Invisible" then
				setInvisible(not state.invisible)
			end

			playFunctionSound()
		end
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		teleportToMouse()
	end

	if input.UserInputType == Enum.UserInputType.MouseButton3
		and state.lockEnabled then

		if state.lockTarget then
			unlock()
		else
			local target = getBestTarget()

			if target then
				lockOn(target)
			end
		end
	end

	if input.KeyCode == Enum.KeyCode.W then
		flyKeys.W = true
	elseif input.KeyCode == Enum.KeyCode.A then
		flyKeys.A = true
	elseif input.KeyCode == Enum.KeyCode.S then
		flyKeys.S = true
	elseif input.KeyCode == Enum.KeyCode.D then
		flyKeys.D = true
	elseif input.KeyCode == Enum.KeyCode.Space then
		flyKeys.Space = true
	elseif input.KeyCode == Enum.KeyCode.LeftControl then
		flyKeys.Ctrl = true
	end
end)

